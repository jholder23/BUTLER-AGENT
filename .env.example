# Copy to .env and fill in. Never commit .env.

OPENAI_API_KEY=

# Optional: OpenAI model for Butler â†’ 3D print (OpenSCAD generation). Default gpt-4o-mini.
# BUTLER_PRINT3D_MODEL=gpt-4o-mini
# Full path to OpenSCAD CLI if not on PATH (Windows: often ...\OpenSCAD 2021.01\openscad.com).
# BUTLER_OPENSCAD=C:\Program Files\OpenSCAD 2021.01\openscad.com
# 3D print: default is STL-only (.scad is temp; print3d/ gets .stl when OpenSCAD CLI works). Set both to also keep .scad beside STL.
# BUTLER_PRINT3D_OUTPUT=stl
# BUTLER_PRINT3D_OUTPUT=both
# OpenAI-compatible server base for 3D print â€œcompatâ€ engine (Ollama default http://127.0.0.1:11434 â€” no /v1 suffix).
# BUTLER_PRINT3D_V1_URL=http://127.0.0.1:11434
# Default model name sent to /v1/chat/completions for compat engine.
# BUTLER_PRINT3D_COMPAT_MODEL=llama3.2

# Owner mode: stronger â€œyou control this machineâ€ instructions to the Knowledge API + softer autonomy repair hints.
# Default is ON (unset). Set BUTLER_OWNER_MODE=0 to disable. Does not disable OS/file sandboxingâ€”that is Settings.
# BUTLER_OWNER_MODE=1

# Actions mode: after run_command fails, re-ask the model (up to N extra apply rounds). Default 15 if unset. 0 = stop after first failure.
# BUTLER_ACTIONS_AUTONOMY_ROUNDS=15
# Per apply failure, how many times to re-prompt if the model returns chat instead of mode "actions" (default 5).
# BUTLER_ACTIONS_AUTONOMY_INNER=5

# Network monitor: full path to tshark.exe if Butler cannot find it (Wireshark installs here by default on 64-bit Windows).
# On Windows, Butler runs winget once per session to install Wireshark if tshark is missingâ€”unless you set:
# BUTLER_SKIP_AUTO_WIRESHARK=1
# After a manual install from https://www.wireshark.org/ restart Butler. If probe still fails, set explicitly:
# BUTLER_TSHARK_PATH=C:\Program Files\Wireshark\tshark.exe
# Default capture interface index (from `tshark -D`). Overridden by the Settings UI when you start capture.
# BUTLER_NETWORK_INTERFACE=1

# Knowledge API (Python api_server.py on 8765). Do not use Butler ui-server port 4001 here.
KNOWLEDGE_API_URL=http://127.0.0.1:8765

# Butler user data folder (profile.json, applications/, generated/, apartments, Gmail tokens).
# Windows default: D:\butlor  |  macOS/Linux: ~/Documents/Butlor
# BUTLOR_CONFIG=

# Local LLM (Ollama OpenAI-compatible). Knowledge peepee_ai posts to {url}/chat/completions.
# Prefer a free uncensored instruct model that fits ~12GB VRAM (7B–8B with Comfy; 14B when image stack unloaded).
# Default: dolphin-llama3:8b (Cognitive Computations Dolphin) — `ollama pull dolphin-llama3:8b`
BUTLOR_AI_URL=http://127.0.0.1:11434/v1
PEEPEEDEE_AI_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL=dolphin-llama3:8b
# Keep Dolphin loaded in Ollama between turns (default -1 = forever). Cold reload is a major latency hit.
# BUTLER_OLLAMA_KEEP_ALIVE=-1
# BUTLER_OLLAMA_KEEP_ALIVE=30m
# Cap generation length on greetings / voice / casual only (full Q&A still uses BUTLER_CHAT_MAX_TOKENS).
# BUTLER_CHAT_PHATIC_MAX_TOKENS=256
# Prior turns forwarded on voice/casual (full chat still uses BUTLER_CHAT_HISTORY).
# BUTLER_CHAT_PHATIC_HISTORY=6
# Agent local fallback uses the SAME uncensored model (cascade free tiers stay primary for Agent).
# Leave other Ollama tags on disk; Butler will not pull/load them.
LOCAL_AGENT_MODEL=dolphin-llama3:8b
# Local vision VLM for image Q&A (“what’s in this?”). Compact default for VRAM beside Comfy.
# Pull once: ollama pull moondream
# Alternatives: llava:7b | qwen2.5-vl:3b — set LOCAL_VISION_MODEL accordingly.
LOCAL_VISION_MODEL=moondream
# VRAM trim (defaults ON when unset in config): video + MusicGen stay on disk but do not run.
BUTLER_DISABLE_VIDEO=1
BUTLER_SKIP_COMFY_VIDEO=1
BUTLER_DISABLE_MUSICGEN=1
# Max tool/LLM iterations per Agent turn (default 48; hard cap 96). Raise for long checklists.
# BUTLER_AGENT_MAX_ITERATIONS=48
# Completion tokens per agent LLM call (default 16384). Raise if finals still cut mid-sentence.
# BUTLER_AGENT_MAX_TOKENS=16384
# Agent window default provider: local | auto_free | gemini | groq | openrouter | mistral | cohere
# auto_free (also: cascade) walks free tiers best→worst using available keys, then LOCAL_AGENT_MODEL.
# Toggle lives in Agent Settings (persisted as butler_agent_auto_free_cascade / butler_agent_provider in localStorage).
# BUTLER_AGENT_PROVIDER=auto_free
# Ranked free cloud fallbacks (best→worst) for auto_free or when a cloud provider hits rate limits:
#   1. GEMINI_API_KEY     → gemini-2.0-flash (~1,500 req/day, no credit card)
#   2. GROQ_API_KEY       → llama-3.3-70b-versatile (~30 RPM, no credit card)
#   3. OPENROUTER_API_KEY → meta-llama/llama-3.3-70b-instruct:free
#   4. MISTRAL_API_KEY    → mistral-small-latest (experiment tier)
#   5. COHERE_API_KEY     → command-r-08-2024 (free trial)
# Final fallback is always LOCAL_AGENT_MODEL (Ollama). Agent path only — regular /chat unchanged.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# COHERE_API_KEY=

# --- Agent MCP (Model Context Protocol) ---
# Node ui-server hosts MCP sessions (agent-mcp-host.mjs). Knowledge agent calls them via
# mcp_list / mcp_call → BUTLER_MCP_BRIDGE_URL (default http://127.0.0.1:4001).
# BUTLER_MCP_BRIDGE_URL=http://127.0.0.1:4001
# Context7 library docs MCP (https://context7.com/dashboard). Required to enable the pre-seeded
# Context7 server — connect stays needs_key / disabled until set.
# Prefer Agent Settings → Environment variables (local agent-env.json) over editing this file.
# CONTEXT7_API_KEY=
# Optional path for @modelcontextprotocol/server-memory JSONL (default: Documents/Butlor/mcp-memory/memory.jsonl)
# MEMORY_FILE_PATH=
# Sequential Thinking MCP (@modelcontextprotocol/server-sequential-thinking) — free/local, no API key.
# Auto-enabled in Agent MCP defaults as mcp-sequential-thinking.

# Answer pipeline: knowledge-first â†’ local LLM â†’ on refusal/gap: knowledge + web scrape/synth (no cloud) â†’ learn into store.
BUTLER_KNOWLEDGE_FIRST=1
# Default for /chat is local-only generation; set BUTLER_CHAT_CLOUD=1 to re-enable OpenAI overlays.
BUTLER_CHAT_CLOUD=0

# Legacy only: phrase-matched shortcuts (txt2img/img2img/txt2video/MusicGen/calendar) that bypass the LLM on /chat.
# Default is OFFâ€”intent comes from structured model JSON only. Set to 1 if your local LLM is often down and you rely on those paths.
# BUTLER_REGEX_INTENT_ROUTING=1

# Optional: `npm run desktop` / `npm run release` copies portable App + NSIS installer here
# (default: <repo>/dist-desktop).
# BUTLER_RELEASE_ROOT=D:\Butler-Desktop

# Also treat generic â€œgenerate â€¦ / render â€¦â€ as direct SD when not local-only (broader; optional)
# BUTLER_DIRECT_SD_LOOSE=1

# Codegen scratch (ui-server.js); use your Butler root + projects\ui
CODE_HELPER_PROJECTS_ROOT=D:\BUTLER\projects\ui

# Full disk for Butler file/command actions (Electron). Use 0 to lock down.
BUTLER_ALLOW_ANY_PATH=1

# Allow Code agent / actions to edit Butler's own source (ui/src, knowledge/agent.py, …).
# Default OFF — without this, those writes are refused so the agent cannot blank its own UI.
# BUTLER_ALLOW_SELF_EDIT=1

# Default project root hint for the model
BUTLER_GLOBAL_PROJECT_ROOT=D:\

# Semicolon-separated trusted roots (broader backup when policies check roots)
BUTLER_TRUSTED_ROOTS=D:\;C:\

# Default checkpoint for Butlerâ†’Comfy (txt2img/img2img). Default: Pony XL from scripts/download_comfy_checkpoint.py.
# Set to workflow to use each workflow JSONâ€™s embedded ckpt_name instead.
# BUTLER_COMFY_CHECKPOINT=ponyDiffusionV6XL_v6StartWithThisOne.safetensors
# Optional: skip Butlerâ€™s extra negative-prompt tuning so your chat text goes to Comfy as-is (strongest â€œno guardrailsâ€ for CLIP).
# BUTLER_SKIP_SD_PROMPT_ENHANCE=1
# FaceID + explicit local img2img: `python scripts/install_faceid_stack.py` (CLIP + IPAdapter unnorm); Impact/FaceDetailer: `python scripts/install_comfy_explicit_nodes.py`.
# Default img2img workflow is img2img_butler_faceid_explicit_ultimate_nsfw when bundled; falls back to VAE-simple if Comfy queue fails.

# SD root: ComfyUI/workflows, models, ComfyUI/input. Default is <Butler root>/sd — leave unset to use the project copy.
# Relative paths resolve from the Butler repo root (ui-server + Knowledge API).
# Packaged desktop: Electron does not ship Comfy under resources\sd. Release sets SD_PROJECT_PATH to this machine's
# <Butler>/sd; otherwise the app walks up from Butler.exe to find sd\ComfyUI\main.py. Override if needed:
# SD_PROJECT_PATH=C:\path\to\your\sd
# ComfyUI HTTP API. Dev / npm run dev: 8188. Packaged desktop defaults to 8198 (same install, separate process + temp).
# COMFYUI_URL=http://127.0.0.1:8188
# Desktop override (also written into dist-desktop App\resources\.env by npm run desktop):
# COMFYUI_URL=http://127.0.0.1:8198
# Optional: override desktop Comfy temp/input/output root (default %TEMP%\butler-comfyui-desktop)
# BUTLER_COMFY_TEMP_ROOT=C:\Temp\butler-comfyui-desktop
# Optional: replace default Comfy CLI flags (desktop otherwise uses --normalvram --fp16-vae --disable-cuda-malloc --disable-pinned-memory + separate dirs)
# COMFYUI_EXTRA_ARGS=--disable-cuda-malloc
# Optional: also treat loose “generate/render/NSFW…” phrasing as direct Comfy (local GPU; Butler does not censor prompts).
# BUTLER_DIRECT_SD_LOOSE=1
# SD img2img / image2video: default still image from Desktop — rb, rb.png, rb.jpg, … (set BUTLER_SD_DESKTOP_RB=0 to disable).
# Optional: Forge/A1111 API (default http://127.0.0.1:7860) for img→vid / txt→vid extensions
# SD_API_URL=http://127.0.0.1:7860
# Optional: Python scripts that print JSON {"video":"<base64>","path":"optional"} for custom stacks
# SD_VIDEO_SCRIPT=
# SD_TXT2VIDEO_SCRIPT=
# ComfyUI video workflows (API JSON under %SD_PROJECT_PATH%/ComfyUI/workflows/). Defaults: butler_txt2video, butler_img2video
# COMFY_TXT2VIDEO_WORKFLOW=butler_txt2video
# COMFY_IMG2VIDEO_WORKFLOW=butler_img2video
# Video is disabled by default (BUTLER_DISABLE_VIDEO=1 above). Set BUTLER_DISABLE_VIDEO=0 to allow Wan paths.
# BUTLER_SKIP_COMFY_VIDEO=1 already set with VRAM trim — skips Comfy video even if video re-enabled.
# Disable Butler's local photoreal / anatomy negative prompt tuning for Comfy (see knowledge/sd_prompt_enhance.py)
# BUTLER_SKIP_SD_PROMPT_ENHANCE=0
# Your fixed positive/negative: Butler chat text is merged first on the positive, then this base (deduped). Negatives: base first, then chat, then Butler defaults when enhance is on.
# Sources (first non-empty per field wins): BUTLER_SD_BASE_POSITIVE / BUTLER_SD_BASE_NEGATIVE â†’ BUTLER_SD_BASE_PROMPTS_JSON â†’ <SD_PROJECT_PATH>/butler_sd_base_prompts.json â†’ Documents/Butlor/comfy_config.json base_positive_prompt / base_negative_prompt
# BUTLER_SD_BASE_POSITIVE=
# BUTLER_SD_BASE_NEGATIVE=
# BUTLER_SD_BASE_PROMPTS_JSON=C:\path\to\prompts.json
# Triple img2img compare runs only when the prompt starts with /test (or compare_nsfw_triple:true). Set 1 to force single workflow always.
# BUTLER_IMG2IMG_SINGLE=0
# After /test triple: radial merge (centerâ†’lock face, edgesâ†’balanced+bold). Set 0 for three panels only.
# BUTLER_COMPARE_TRIPLE_MERGE=1
# BUTLER_COMPARE_MERGE_FACE_WEIGHT=0.88
# BUTLER_COMPARE_MERGE_EDGE_FALLOFF=1.75

# Heavy self-learning (Chroma RAG + JSONL journal + auto few-shot file). Set 0 to disable journal/compactor.
# BUTLER_HEAVY_LEARNING=1
# Settings â†’ "Go learn" batch job (optional tuning):
# BUTLER_LEARN_MAX_TOPICS=120
# BUTLER_LEARN_DELAY_SEC=3
# BUTLER_LEARN_RESULTS_PER_TOPIC=5
# BUTLER_LEARN_USE_LOCAL_LLM=0
# BUTLER_LEARN_LLM_TOPICS=24
# Training log (default: Documents/Butlor/butler_training.jsonl)
# BUTLER_TRAINING_LOG=
# RAG memory chunks injected into the local model (default 12)
# BUTLER_MEMORY_BLOCKS=12
# How often to refresh knowledge/auto_intent_examples.json from the journal (seconds)
# BUTLER_LEARNING_COMPACT_SEC=600
# Max rows merged into auto_intent_examples.json
# BUTLER_AUTO_INTENT_MAX=40
# Cap for hand + auto examples in the system prompt
# BUTLER_INTENT_EXAMPLES_CAP=16
# Fully local intent (no OpenAI JSON repair): 0 disables gpt-4o-mini structured passes in knowledge/agent.py
# Default for /chat is local-only generation; set BUTLER_CHAT_CLOUD=1 to re-enable OpenAI overlays.
# BUTLER_CHAT_CLOUD=0
# BUTLER_OPENAI_INTENT=0
# Prior turns forwarded to the local model (default 24)
# BUTLER_CHAT_HISTORY=24
# Prefer local LLM restatement of retrieval queries from history (0 = heuristic backup only)
# BUTLER_LLM_QUERY_RESOLVE=1

# Local MusicGen (optional: pip install -r knowledge/requirements-audio.txt). Default clip length when the prompt is not a one-shot / SFX style ask.
# BUTLER_MUSICGEN_DURATION=8
# BUTLER_MUSICGEN_MODEL=facebook/musicgen-small
# Force backend: transformers | audiocraft (default tries transformers first)
# BUTLER_MUSICGEN_BACKEND=

# Spotify Web API — SEO playlists to promote your tracks (knowledge/spotify_helper.py).
# Create an app at https://developer.spotify.com/dashboard and add Redirect URI below.
# Then: python knowledge/spotify_oauth_setup.py
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:4389/callback

# FORMA / SerumBoi music knowledge base (genres, artists, sound classes, recipes).
# Butler reads this for general music/sound-design answers + SEO playlist niches.
# Default: D:\FORMA\knowledge (also checks D:\SERUMBOI\FORMA\knowledge).
# FORMA_KNOWLEDGE_PATH=D:\FORMA\knowledge
# Set 0 to disable. BUTLER_FORMA_ALWAYS=1 injects FORMA context even when the ask is not music-ish.
# BUTLER_FORMA_KNOWLEDGE=1
# BUTLER_FORMA_ALWAYS=0
