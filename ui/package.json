{
  "name": "code-helper-ui",
  "version": "0.1.1",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "dev": "node ../scripts/dev-entry.mjs",
    "app": "electron .",
    "dev:app": "concurrently \"npm run dev:vite\" \"wait-on http://127.0.0.1:5173 && node scripts/run-dev-electron.mjs\"",
    "build": "vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "prepare-installer": "node scripts/prepare-installer.js",
    "make-icon": "node scripts/make-icon.js",
    "clean": "node scripts/clean-build.js",
    "build:app": "npm run clean && npm run make-icon && npm run prepare-installer && npm run build && node scripts/run-electron-builder-win.mjs && node scripts/desktop-shortcut.js",
    "build:app-agent": "npm run clean && npm run make-icon && npm run prepare-installer && npm run build && node scripts/run-electron-builder-win.mjs --config=build-agent.json",
    "installer": "npm run build:app",
    "go": "npm run build:app"
  },
  "dependencies": {
    "@react-three/drei": "^9.105.6",
    "@react-three/fiber": "^8.16.8",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "cheerio": "^1.0.0-rc.12",
    "express": "^4.21.2",
    "openai": "^5.0.0",
    "pdfkit": "^0.18.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-quill": "^2.0.0",
    "three": "^0.164.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^9.2.1",
    "electron": "^37.2.6",
    "electron-builder": "^26.8.1",
    "electronmon": "^2.0.3",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.you.codehelper",
    "productName": "Butler",
    "directories": {
      "output": "dist-app-new"
    },
    "files": [
      "dist/**",
      "electron/**",
      "../ui-server.js",
      "../butlor-data-root.mjs",
      "../resumePdfKit.mjs",
      "../resume-pdf-presets.json",
      "../resumeDocxKit.mjs",
      "../resume-docx-presets.json",
      "../sd-fill-from-disk.mjs",
      "../network-monitor.mjs",
      "../.env"
    ],
    "asarUnpack": [],
    "extraFiles": [
      {
        "from": "scripts/Butler-Rebuild.cmd",
        "to": "."
      },
      {
        "from": "scripts/Butler-Launch.cmd",
        "to": "."
      },
      {
        "from": "scripts/Butler-Start.cmd",
        "to": "."
      }
    ],
    "extraResources": [
      {
        "from": "../desktop-rb-helper.cjs",
        "to": "desktop-rb-helper.cjs"
      },
      {
        "from": "../print3d-openscad.mjs",
        "to": "print3d-openscad.mjs"
      },
      {
        "from": "../knowledge",
        "to": "knowledge",
        "filter": [
          "**/*",
          "!knowledge_db",
          "!knowledge_db/**/*",
          "!**/__pycache__",
          "!**/__pycache__/**/*",
          "!**/*.pyc",
          "!tests",
          "!tests/**/*",
          "!.pytest_cache",
          "!.pytest_cache/**/*"
        ]
      },
      {
        "from": "python-embed",
        "to": "python-embed"
      },
      {
        "from": "../.env",
        "to": ".env"
      }
    ],
    "win": {
      "target": [
        "dir",
        "nsis"
      ],
      "icon": "electron/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Butler",
      "include": "electron/installer.nsh",
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico"
    }
  }
}